# Copy to .env and fill in. NEVER commit the real .env.

# --- Django
DEBUG=False
SECRET_KEY=generate-a-long-random-string-here
# Fernet key for encrypting bank account numbers at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored account numbers unreadable - back it up securely.
FIELD_ENCRYPTION_KEY=
ALLOWED_HOSTS=hrm.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://hrm.example.com
CORS_ALLOWED_ORIGINS=https://hrm.example.com
FRONTEND_URL=https://hrm.example.com
# Set to False only if TLS is terminated elsewhere and you test over plain http
SECURE_SSL_REDIRECT=False
AUTH_COOKIE_SECURE=True

# --- Database / cache
POSTGRES_DB=shinelight
POSTGRES_USER=shinelight
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://shinelight:change-me@db:5432/shinelight
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ShineLight HRM <hr@example.com>

# --- SMS (console | hubtel | arkesel). Enable the "SMS" module in Settings too.
SMS_PROVIDER=console
SMS_SENDER_ID=ShineLight
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
ARKESEL_API_KEY=

# --- Document storage (optional S3 / MinIO; default is the local media volume)
USE_S3=False
S3_BUCKET=shinelight-documents
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SSE=False

HTTP_PORT=80
