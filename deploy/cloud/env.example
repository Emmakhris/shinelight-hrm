# ShineLight HRM - CLOUD edition (multi-organization SaaS you host).
# Copy to the project root as .env:   cp deploy/cloud/env.example .env   and fill in every "change-me".
# NEVER commit the real .env. Keep SECRET_KEY, FIELD_ENCRYPTION_KEY, both database passwords and
# BACKUP_PASSPHRASE in your password manager / secret store, not only on the server.

# --- Edition and compose files (do not change)
DEPLOYMENT_MODE=cloud
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:deploy/cloud/compose.yml
COMPOSE_PROJECT_NAME=shinelight

# --- Domain. Customers are served at <code>.SAAS_BASE_DOMAIN (DNS: A records for the domain and *.domain)
SAAS_BASE_DOMAIN=shinelighthrm.com
ACME_EMAIL=ops@shinelighthrm.com
# "backend" and "localhost" are needed for Caddy's certificate check and the container health check.
# Customers' custom domains (Organization.domain) must be added here too, comma-separated.
ALLOWED_HOSTS=.shinelighthrm.com,backend,localhost
CSRF_TRUSTED_ORIGINS=https://*.shinelighthrm.com
CORS_ALLOWED_ORIGINS=https://shinelighthrm.com
# Used in emails that aren't tied to one organization
FRONTEND_URL=https://shinelighthrm.com
AUTH_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
USE_X_FORWARDED_HOST=False
# Caddy + the frontend's nginx sit in front of the backend
TRUSTED_PROXY_COUNT=2

# --- Sign-up and plans
SAAS_SIGNUP_ENABLED=False
SAAS_DEFAULT_PLAN=trial

# --- Django
DEBUG=False
SECRET_KEY=change-me
FIELD_ENCRYPTION_KEY=change-me

# --- Database. POSTGRES_USER is the superuser (backups, maintenance); the application connects as APP_DB_USER,
# a non-superuser created on first start, so PostgreSQL row-level security applies to it.
POSTGRES_DB=shinelight
POSTGRES_USER=shinelight_admin
POSTGRES_PASSWORD=change-me
APP_DB_USER=shinelight_app
APP_DB_PASSWORD=change-me-too
DATABASE_URL=postgres://shinelight_app:change-me-too@db:5432/shinelight
DB_ROW_LEVEL_SECURITY=True
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
WORKER_CONCURRENCY=4

# --- Email (a transactional provider: SES, Postmark, Mailgun, SendGrid...)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ShineLight HRM <no-reply@shinelighthrm.com>

# --- SMS (hubtel | arkesel)
SMS_PROVIDER=console
SMS_SENDER_ID=ShineLight
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
ARKESEL_API_KEY=

# --- Document storage: use S3-compatible object storage in the cloud
USE_S3=True
S3_BUCKET=shinelight-documents
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SSE=True

# --- AI assistant (your key; each organization still has to switch the feature on)
ANTHROPIC_API_KEY=
