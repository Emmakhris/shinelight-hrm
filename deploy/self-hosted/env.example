# ShineLight HRM - SELF-HOSTED edition (one organization on the customer's own server).
# Copy to the project root as .env:   cp deploy/self-hosted/env.example .env   and fill in every "change-me".
# NEVER commit the real .env. Keep a copy of SECRET_KEY, FIELD_ENCRYPTION_KEY and the database password
# in the customer's password manager: without FIELD_ENCRYPTION_KEY, stored bank numbers cannot be read.

# --- Edition and compose files (do not change)
DEPLOYMENT_MODE=self_hosted
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:deploy/self-hosted/compose.yml
COMPOSE_PROJECT_NAME=shinelight

# --- Address staff will use
# The host name staff type in the browser, e.g. hr.korlebu.gov.gh (public) or hr.clinic.local (office network only)
SITE_ADDRESS=hr.example.com
# public = Let's Encrypt (needs internet access on ports 80/443); internal = office-network certificate
TLS_MODE=public
ALLOWED_HOSTS=hr.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://hr.example.com
CORS_ALLOWED_ORIGINS=https://hr.example.com
FRONTEND_URL=https://hr.example.com
AUTH_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
USE_X_FORWARDED_HOST=False
# Caddy + the frontend's nginx sit in front of the backend
TRUSTED_PROXY_COUNT=2

# --- Django
DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me

# --- Database / cache (the database runs in its own container on this server)
POSTGRES_DB=shinelight
POSTGRES_USER=shinelight
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://shinelight:change-me@db:5432/shinelight
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- Email (the customer's SMTP server or Microsoft 365 / Google Workspace relay)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=HR <hr@example.com>

# --- SMS (console | hubtel | arkesel); also switch on the SMS module in Organization settings
SMS_PROVIDER=console
SMS_SENDER_ID=ShineLight
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
ARKESEL_API_KEY=

# --- Document storage (default: the media volume on this server)
USE_S3=False

# --- Optional: AI assistant (the customer's own Anthropic API key; leave empty to keep it off)
ANTHROPIC_API_KEY=

# --- Not used by the self-hosted edition
SAAS_BASE_DOMAIN=
SAAS_SIGNUP_ENABLED=False
DB_ROW_LEVEL_SECURITY=False
